<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root alignment="TOP_RIGHT" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
         prefWidth="400.0" stylesheets="@../css/dialogbox.css" type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx/26"
         xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="dialog" maxWidth="235.0" minHeight="-Infinity" styleClass="dialog-label" text="Label"
               wrapText="true">
            <HBox.margin>
                <Insets left="6.0" right="6.0" />
            </HBox.margin>
            <padding>
                <Insets bottom="7.0" left="10.0" right="10.0" top="7.0" />
            </padding>
        </Label>
        <ImageView fx:id="displayPicture" fitHeight="54.0" fitWidth="54.0" pickOnBounds="true"
                   preserveRatio="true" />
    </children>
    <padding>
        <Insets bottom="3.0" left="2.0" right="2.0" top="3.0" />
    </padding>
</fx:root>
