<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="680.0" prefWidth="440.0" stylesheets="@../css/main.css" xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="peanutbuttercat.MainWindow">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="88.0" spacing="12.0" styleClass="brand-bar"
              AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <ImageView fitHeight="58.0" fitWidth="58.0" preserveRatio="true" styleClass="brand-avatar">
                    <image>
                        <Image url="@../images/DaDuke.png" />
                    </image>
                </ImageView>
                <VBox spacing="2.0">
                    <children>
                        <Label styleClass="brand-title" text="PeanutButterCat" />
                        <Label styleClass="brand-subtitle" text="Cozy task keeper • fueled by peanut butter" />
                    </children>
                </VBox>
            </children>
            <padding>
                <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
            </padding>
        </HBox>
        <TextField fx:id="userInput" onAction="#handleUserInput" prefHeight="42.0"
                   promptText="What's on your plate?" AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="12.0"
                   AnchorPane.rightAnchor="102.0" />
        <Button fx:id="sendButton" mnemonicParsing="false" onAction="#handleUserInput" prefHeight="42.0"
                prefWidth="82.0" text="Send 🐾" AnchorPane.bottomAnchor="12.0" AnchorPane.rightAnchor="12.0" />
        <ScrollPane fx:id="scrollPane" hbarPolicy="NEVER" hvalue="1.0" vvalue="1.0"
                    AnchorPane.bottomAnchor="66.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="88.0">
            <content>
                <VBox fx:id="dialogContainer" prefWidth="428.0" spacing="10.0">
                    <padding>
                        <Insets bottom="14.0" left="12.0" right="12.0" top="14.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
